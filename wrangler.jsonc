// Cloudflare Workers — static deploy (Workers Static Assets, no Worker script).
// Build: bundle exec jekyll build   → ./_site
// Deploy: npx wrangler deploy
// The old domain nkr.si stays on GitHub Pages and redirects here
// (redirect_to in .github/workflows/jekyll.yml).
{
  "name": "nkrsi-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    // Serve the Jekyll-generated 404.html for missing paths
    "not_found_handling": "404-page",
    // /projekty -> /projekty/ (Jekyll permalink style)
    "html_handling": "auto-trailing-slash"
  },
  // Custom domain (zone must be on Cloudflare in this account; any existing
  // DNS records for the hostname must be removed first).
  "routes": [
    { "pattern": "nkrsi.io", "custom_domain": true }
  ]
}
